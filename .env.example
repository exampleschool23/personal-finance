SUPABASE_URL=https://hnwxybhsvnutcsqwscul.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional: enables USD stock quotes and adjusted stock/ETF benchmark history. Keep server-side.
TWELVE_DATA_API_KEY=

# Background portfolio capture, account deletion and rate limits (migration 106;
# without the key requests are not limited). Never expose these to the browser.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical auth email destination; no path, query, or credentials.
APP_ORIGIN=
# Also verify Supabase admission settings and email confirmation before enabling.
PUBLIC_SIGNUP_ENABLED=false

# Signs new JSON backups for recovery after database loss. At least 32 random
# bytes; preserve this key OUTSIDE the database and reuse it on recovery servers.
# Recovery also requires SUPABASE_SERVICE_ROLE_KEY and the original auth user ID.
BACKUP_SIGNING_KEY=

# Telegram bot: morning digest, a message after every saved action, and
# adding records with buttons. Create the bot with @BotFather, then register the
# webhook (see VERCEL.md). Keep the token and secret server-side.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Key of the derived passwords of accounts created in Telegram (one-tap and Mini App sign-in). A long random string,
# different from TELEGRAM_WEBHOOK_SECRET, which travels in a header on every webhook call. Until it is set the webhook
# secret is used; once set, older accounts move to it on their next sign-in. Never rotate it casually.
TELEGRAM_LOGIN_SECRET=

# Secret of the Supabase Send SMS hook that delivers phone sign-in codes through Telegram (docs/telegram-accounts.md).
SEND_SMS_HOOK_SECRET=

# Optional: the in-app Assistant (Claude by Anthropic). Without it the Assistant
# page says it is not set up. Questions and a summary of the user's records are
# sent to Anthropic's API. Keep server-side.
ANTHROPIC_API_KEY=

# Optional: error monitoring (lib/monitoring.ts, VERCEL.md "Monitoring and alerts"). Every server error is already
# one scrubbed JSON line in the Vercel logs; with a DSN it is also sent to Sentry (free Developer plan), without SDK.
# Sentry › Project settings › Client Keys (DSN), e.g. https://<key>@o123.ingest.sentry.io/456
SENTRY_DSN=
# Optional: the Telegram chat that receives operator alerts (cron failures, webhook and sign-in code failures,
# repeated database errors) from the bot above. To find your chat id, send any message to the bot, then open
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and copy "chat":{"id":...}; a group id is negative.
# Do this before setting the webhook, or temporarily delete it (deleteWebhook), since getUpdates is empty while a
# webhook is set. Alerts never contain user data and are sent at most once an hour per failure.
TELEGRAM_ALERT_CHAT_ID=
